{
  "manifest_version": 3,
  "name": "SynthScan",
  "version": "0.1.0",
  "description": "Open-source AI-content authenticity scanner. Detects AI-generated text on any page via your self-hosted SynthScan server.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SynthScan"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
